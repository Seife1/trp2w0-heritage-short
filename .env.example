# Google AI Studio / Gemini API (Gemini 3.8 Flash, Flash-Lite, Gemini 3.8 Flash TTS)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI (FLUX.2 klein / FLUX.1 schnell)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Optional: Kaggle API credentials (for remote batch GPU execution if using Kaggle API)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Pipeline execution settings
ENVIRONMENT=development
LOG_LEVEL=INFO
